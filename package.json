{
  "name": "nga-translate",
  "version": "22.0.0",
  "author": "Sajad Mehrabi",
  "description": "Angular ngx-translate wrapper for support default translate and prefixed translations.",
  "license": "MIT",
  "scripts": {
    "build:lib": "ng build nga-translate",
    "deploy": "npm run build:lib && npm publish --access=public dist",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "npm run lint -- --fix",
    "ng": "ng",
    "prepare": "husky install",
    "prettier:check": "prettier --check \"{,src/**/}*.{md,json,yml,html,cjs,mjs,js,ts,tsx,css,scss}\"",
    "prettier:format": "prettier --write \"{,src/**/}*.{md,json,yml,html,cjs,mjs,js,ts,tsx,css,scss}\"",
    "start": "ng serve",
    "test": "ng test"
  },
  "keywords": [
    "ngx",
    "ng",
    "nga",
    "avan",
    "angular",
    "wrapper",
    "default translate",
    "wrapper ngx-translate",
    "library",
    "angular translate wrapper"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mehrabisajad/nga-translate.git"
  },
  "private": false,
  "lint-staged": {
    "{,src/**/,webpack/}*.{md,json,yml,html,cjs,mjs,js,ts,tsx,css,scss}": "prettier --write"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@ngx-translate/core": "^18.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "ng-packagr": "^22.2.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
